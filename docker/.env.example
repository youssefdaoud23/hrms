# Local development only. Copy to docker/.env and choose your own passwords.
# Credentials shown here are insecure demo defaults; never use with real HR records.
MARIADB_ROOT_PASSWORD=123
HRMS_ADMIN_PASSWORD=admin
MARIADB_IMAGE=mariadb:11.8
REDIS_IMAGE=redis:7.4-alpine
FRAPPE_BENCH_IMAGE=frappe/bench:v5.31.1
FRAPPE_BRANCH=develop
ERPNEXT_BRANCH=develop
HRMS_BRANCH=develop
HRMS_APP_REPO=https://github.com/youssefdaoud23/hrms.git
HRMS_SITE_NAME=hrms.localhost
HRMS_HOST_BIND=127.0.0.1
HRMS_HTTP_PORT=8000
HRMS_SOCKETIO_PORT=9000
